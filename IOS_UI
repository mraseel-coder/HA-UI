                            else { this.dispatchEvent(new CustomEvent('hass-action', {composed: true, bubbles: true, detail: { config: { tap_action: { action: 'call-service', service: 'rest_command.${service}', service_data: {} } } } })); }
                          })();
                        `.replace(/\n/g, ' ');

                        const muteToggleAction = `
                          (() => {
                            const key = 'dome_muted';
                            const muted = localStorage.getItem(key) === '1';
                            const service = muted ? 'unmute' : 'mute';
                            localStorage.setItem(key, muted ? '0' : '1');
                            const label = this.querySelector('.lbl');
                            if(label) label.innerText = muted ? 'Unmuted' : 'Muted';
                            const h = this.getRootNode()?.host?.hass || document.querySelector('home-assistant')?.hass || document.querySelector('hc-main')?.hass;
                            if(h) { h.callService('rest_command', service, {}); }
                            else { this.dispatchEvent(new CustomEvent('hass-action', {composed: true, bubbles: true, detail: { config: { tap_action: { action: 'call-service', service: 'rest_command.' + service, service_data: {} } } } })); }
                          })();
                        `.replace(/\n/g, ' ');

                        const startContentAction = rest('dome_play') + ` setTimeout(() => { ${rest('next_content')} }, 1000);`;
                        const turnOnAction  = call('switch','turn_on','switch.dome_fans_socket_1') + call('switch','turn_on','switch.blueai_screen_socket_1') + rest('projectors_on') + ` setTimeout(() => { ${startContentAction} }, 30000);` + call('input_boolean','turn_off','input_boolean.dome_expander');
                        const shutOffAction = rest('server_shutdown') + ` setTimeout(() => { ${rest('projectors_off')} ${call('switch','turn_off','switch.dome_fans_socket_1')} ${call('switch','turn_off','switch.blueai_screen_socket_1')} }, 20000);` + call('input_boolean','turn_off','input_boolean.dome_expander');
                        const muteLabel = localStorage.getItem('dome_muted') === '1' ? 'Muted' : 'Unmuted';

                        return `
                          <div>
                            <div style="display:flex;align-items:center;gap:14px;margin-bottom:22px;">
                              <div style="width:52px;height:52px;border-radius:14px;background:rgba(6,182,212,0.18);
                                display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                <ha-icon icon="mdi:dome-light" style="width:28px;color:#06b6d4;"></ha-icon>
                              </div>
                              <div style="flex:1;">
                                <div style="font-size:20px;font-weight:600;color:#ffffff;">Dome</div>
                                <div style="font-size:13px;margin-top:3px;">${statusHtml}</div>
                              </div>
                            </div>

                            <div style="font-size:11px;font-weight:600;color:rgba(232,237,248,0.35);letter-spacing:0.08em;margin-bottom:8px;">MASTER POWER</div>
                            <div style="display:flex;gap:8px;margin-bottom:16px;">
                              ${btn('Turn ON + Play', 'mdi:power', '#4ade80', 'rgba(74,222,128,0.13)', 'rgba(74,222,128,0.28)', !online, turnOnAction)}
                              ${btn('Turn OFF', 'mdi:power-sleep', '#f87171', 'rgba(248,113,113,0.12)', 'rgba(248,113,113,0.26)', online, shutOffAction)}
                            </div>

                            <div style="border-top:1px solid rgba(255,255,255,0.08);margin-bottom:16px;"></div>

                            <div style="font-size:11px;font-weight:600;color:rgba(232,237,248,0.35);letter-spacing:0.08em;margin-bottom:8px;">DOME BRIDGE</div>
                            <div style="display:flex;gap:8px;margin-bottom:8px;">
                              ${dBtn('Projectors ON','mdi:projector','#4ade80','rgba(74,222,128,0.13)','rgba(74,222,128,0.28)', rest('projectors_on'))}
                              ${dBtn('Projectors OFF','mdi:projector-off','#f87171','rgba(248,113,113,0.12)','rgba(248,113,113,0.26)', rest('projectors_off'))}
                            </div>
                            <div style="display:flex;gap:8px;margin-bottom:16px;">
                              ${dBtn('Start','mdi:play','#4ade80','rgba(74,222,128,0.13)','rgba(74,222,128,0.28)', startContentAction)}
                              ${dBtn('Pause','mdi:pause','#fbbf24','rgba(251,191,36,0.12)','rgba(251,191,36,0.26)', rest('dome_pause'))}
                              ${dBtn('Stop','mdi:stop','#f87171','rgba(248,113,113,0.12)','rgba(248,113,113,0.26)', rest('dome_stop'))}
                            </div>
                            <div style="display:flex;gap:8px;margin-bottom:8px;">
                              ${dBtn('Shutdown','mdi:power-plug-off','#f87171','rgba(248,113,113,0.12)','rgba(248,113,113,0.26)', rest('server_shutdown'))}
                              ${dBtn('Restart','mdi:restart','#fbbf24','rgba(251,191,36,0.12)','rgba(251,191,36,0.26)', rest('server_restart'))}
                            </div>
                            <div style="display:flex;gap:8px;margin-bottom:16px;">
                              ${dBtn('Previous','mdi:skip-previous','#60a5fa','rgba(96,165,250,0.13)','rgba(96,165,250,0.28)', rest('previous_content'))}
                              ${mBtn(muteLabel, muteToggleAction)}
                              ${dBtn('Next','mdi:skip-next','#60a5fa','rgba(96,165,250,0.13)','rgba(96,165,250,0.28)', rest('next_content'))}
                            </div>

                            <div style="font-size:11px;font-weight:600;color:rgba(232,237,248,0.35);letter-spacing:0.08em;margin-bottom:8px;">COMPONENT CONTROL</div>
                            <div style="display:flex;gap:8px;margin-bottom:8px;">
                              ${dBtn('Fan ON','mdi:fan','#4ade80','rgba(74,222,128,0.13)','rgba(74,222,128,0.28)', call('switch','turn_on','switch.dome_fans_socket_1'))}
                              ${dBtn('Fan OFF','mdi:fan-off','#f87171','rgba(248,113,113,0.12)','rgba(248,113,113,0.26)', call('switch','turn_off','switch.dome_fans_socket_1'))}
                            </div>
                            <div style="display:flex;gap:8px;">
                              ${dBtn('Server ON','mdi:server','#4ade80','rgba(74,222,128,0.13)','rgba(74,222,128,0.28)', call('switch','turn_on','switch.blueai_screen_socket_1'))}
                              ${dBtn('Server OFF','mdi:server-network-off','#f87171','rgba(248,113,113,0.12)','rgba(248,113,113,0.26)', call('switch','turn_off','switch.blueai_screen_socket_1'))}
                            </div>
                          </div>
                        `;
                      ]]]
